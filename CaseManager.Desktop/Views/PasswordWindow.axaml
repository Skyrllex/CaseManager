<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CaseManager.Desktop.Views.PasswordWindow"
        Title="Case Manager — вход"
        Width="420" Height="260"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

	<Grid Margin="32" RowDefinitions="Auto,Auto,Auto,*,Auto">

		<TextBlock Grid.Row="0"
				   Text="⚖️ Case Manager"
				   FontSize="24" FontWeight="Bold"
				   Foreground="White"
				   HorizontalAlignment="Center"
				   Margin="0,0,0,8"/>

		<TextBlock Grid.Row="1"
				   Text="Введите мастер-пароль"
				   Foreground="#94A3B8"
				   HorizontalAlignment="Center"
				   Margin="0,0,0,20"/>

		<TextBox Grid.Row="2"
				 Name="PasswordBox"
				 PasswordChar="●"
				 Watermark="Пароль"
				 FontSize="14"
				 Padding="10,8"
				 CornerRadius="6"/>

		<TextBlock Grid.Row="3"
				   Name="ErrorText"
				   Foreground="#F87171"
				   FontSize="12"
				   TextWrapping="Wrap"
				   Margin="0,8,0,0"
				   IsVisible="False"/>

		<Button Grid.Row="4"
				Name="LoginButton"
				Content="Открыть"
				HorizontalAlignment="Stretch"
				Background="#3B82F6"
				Foreground="White"
				Padding="0,10"
				CornerRadius="6"
				FontSize="14"
				FontWeight="SemiBold"/>
	</Grid>
</Window>
